import {
  CoreNamespace,
  LogFormat,
} from '@node-in-layers/core'
import { DataNamespace, SupportedDatabase } from '@node-in-layers/data'
import { LogLevelNames } from '@node-in-layers/core'
import { McpNamespace, McpServerConfig } from '@node-in-layers/mcp-server'
import { AuthNamespace, AuthConfig, LoginApproach, LoginApproachServiceName } from '@node-in-layers/auth'
import { SecretsNamespace, SecretsConfig } from '@node-in-layers/secrets'
import { SystemConfig } from './src/types.js'
import { core as secretsCore, config as secretsConfig } from '@node-in-layers/secrets'
import { auth as authCore } from '@node-in-layers/auth'
import * as data from '@node-in-layers/data'
import * as mcpServer from '@node-in-layers/mcp-server'
import * as health from './src/health/index.js'

export default async (): Promise<SystemConfig> => {
  return {
    environment: 'base',
    systemName: '{{backendName}}',
    [CoreNamespace.root]: {
      // @ts-ignore
      domains: await Promise.all([
        secretsCore,
        secretsConfig,
        data,
        mcpServer,
        authCore,
        health,
      ]),
      layerOrder: ['services', 'features', ['entries', 'mcp']],
      logging: {
        logLevel: LogLevelNames.info,
        logFormat: LogFormat.json,
        ignoreLayerFunctions: {
          '@node-in-layers/mcp-server.addTool': true,
          '@node-in-layers/mcp-server.addUnprotectedRoute': true,
          '@node-in-layers/mcp-server.start': true,
          '@node-in-layers/mcp-server.getApp': true,
          '@node-in-layers/mcp-server.addAnnotatedFunction': true,
          '@node-in-layers/mcp-server.addPreRouteMiddleware': true,
          '@node-in-layers/mcp-server.addAdditionalRoute': true,
          '@node-in-layers/mcp-server.addCrossLayerPropMiddleware': true,
          '@node-in-layers/mcp-server.set': true,
          '@node-in-layers/data.express': true,
          '@node-in-layers/data.services': true,
          '@node-in-layers/data.features': true,
          '@node-in-layers/mcp-server.mcp': true,
        },
      },
      modelFactory: '@node-in-layers/data',
      modelCruds: true,
    },
    [DataNamespace.root]: {
      databases: {
        default: {
          datastoreType: SupportedDatabase.memory,
        },
      },
    },
    [McpNamespace]: {
      stateless: true,
      server: {
        connection: {
          type: 'http',
          url: 'http://localhost',
          port: 3000,
        }
      }
    } as McpServerConfig[typeof McpNamespace],
    [AuthNamespace.Core]: {
      systemLevelPolicies: []
    },
    [AuthNamespace.Api]: {
      authentication: {
        loginApproaches: [
          LoginApproachServiceName.BasicAuthLogin,
          LoginApproachServiceName.ApiKeyAuthLogin,
        ],
        skipAllAuthentication: false,
      }
    } as AuthConfig[typeof AuthNamespace.Api],
    [SecretsNamespace.Core]: {
      // secretServiceFactory, // Replace with a secrets factory if not using json default.
    } as SecretsConfig,
  }
}
