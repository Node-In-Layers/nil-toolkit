{
  "name": "{{fullSdkPackageName}}",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -Rf ./dist && tsgo -p ./tsconfig.json && cp package.json ./dist && cp ./README.md ./dist",
    "build:watch": "nodemon -e '*' --watch ./src --exec \"npm run build || exit 1\"",
    "commit": "cz",
    "dist": "npm run build && cd dist && npm publish",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier -c .",
    "shell": "tsx ./bin/shell.mts",
    "test": "export TS_NODE_PROJECT='./tsconfig.test.json' && mocha -r tsx ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts",
    "test:coverage": "c8 --all --reporter cobertura --reporter text --reporter lcov --reporter html npm run test",
    "test:features": "node run-cucumber.js --config cucumber.config.mjs --format html:reports/cucumber-report.html --format json:reports/cucumber-report.json",
    "tsx": "tsx"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
{{{overridesJson}}}
  "dependencies": {
    "@node-in-layers/core": "{{nodeInLayersCoreVersion}}",
    "@node-in-layers/mcp-client": "{{nodeInLayersMcpClientVersion}}",
    "functional-models-orm-mcp": "{{functionalModelsOrmMcpVersion}}",
    "functional-models": "{{functionalModelsVersion}}",
    "zod": "{{zodVersion}}",
    "lodash": "{{lodashVersion}}"
  },
  "devDependencies": {
    "@cucumber/cucumber": "{{cucumberCucumberVersion}}",
    "@eslint/compat": "{{eslintCompatVersion}}",
    "@eslint/eslintrc": "{{eslintEslintrcVersion}}",
    "@eslint/js": "{{eslintJsVersion}}",
    "@types/chai-as-promised": "{{typesChaiAsPromisedVersion}}",
    "@types/json-stringify-safe": "{{typesJsonStringifySafeVersion}}",
    "@types/lodash": "{{typesLodashVersion}}",
    "@types/mocha": "{{typesMochaVersion}}",
    "@types/node": "{{typesNodeVersion}}",
    "@types/proxyquire": "{{typesProxyquireVersion}}",
    "@types/sinon": "{{typesSinonVersion}}",
    "@typescript-eslint/eslint-plugin": "{{typescriptEslintEslintPluginVersion}}",
    "@typescript-eslint/parser": "{{typescriptEslintParserVersion}}",
    "@typescript/native-preview": "{{typescriptNativePreviewVersion}}",
    "argparse": "{{argparseVersion}}",
    "c8": "{{c8Version}}",
    "chai": "{{chaiVersion}}",
    "chai-as-promised": "{{chaiAsPromisedVersion}}",
    "cz-conventional-changelog": "{{czConventionalChangelogVersion}}",
    "es-main": "{{esMainVersion}}",
    "eslint": "{{eslintVersion}}",
    "eslint-config-prettier": "{{eslintConfigPrettierVersion}}",
    "eslint-import-resolver-typescript": "{{eslintImportResolverTypescriptVersion}}",
    "eslint-plugin-functional": "{{eslintPluginFunctionalVersion}}",
    "eslint-plugin-import": "{{eslintPluginImportVersion}}",
    "fetch-blob": "{{fetchBlobVersion}}",
    "globals": "{{globalsVersion}}",
    "js-yaml": "{{jsYamlVersion}}",
    "json5": "{{json5Version}}",
    "mocha": "{{mochaVersion}}",
    "nodemon": "{{nodemonVersion}}",
    "prettier": "{{prettierVersion}}",
    "proxyquire": "{{proxyquireVersion}}",
    "sinon": "{{sinonVersion}}",
    "sinon-chai": "{{sinonChaiVersion}}",
    "source-map-support": "{{sourceMapSupportVersion}}",
    "ts-node": "{{tsNodeVersion}}",
    "tsx": "{{tsxVersion}}",
    "typescript": "{{typescriptVersion}}"
  }
}
