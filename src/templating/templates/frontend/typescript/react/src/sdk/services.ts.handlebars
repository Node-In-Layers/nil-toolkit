import merge from 'lodash/merge.js'
import { ServicesContext } from '@node-in-layers/core'
import { SdkServices } from './types.js'
import { SystemConfig } from '../types.js'
import { createClient, createConfig } from '{{fullSdkPackageName}}'

export const create = (context: ServicesContext<SystemConfig>): SdkServices => {
  const isAuthenticated = () => context.config.useOAuth2 ? context.config.authUser?.access_token : true
  const getClient = async () => {
    // TODO: Adjust this to your authentication situation.
    const oauth2Token = context.config.authUser?.access_token

    const clientConfig = await createConfig(merge({
      name: context.config.systemName,
      ...context.config,
    }, {
      // Feel free to change this code, if not using OAuth2, or your situation varies.
      ...(context.config.useOAuth2 ? {
        [McpClientNamespace.client]: {
          credentials: {
            header: 'Authorization',
            key: oauth2Token,
            formatter: (key: string) => `Bearer ${key}`,
          }
        }
      } : {}),
    }))
    const client = await createClient(clientConfig)
    return client
  }
  return {
    getClient,
    isAuthenticated,
  }
}