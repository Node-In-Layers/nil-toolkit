{
  "name": "{{fullFrontendPackageName}}",
  "type": "module",
  "version": "1.0.0",
  "description": "A React frontend using Node in Layers. Generated by the Node in Layers Toolkit.",
  "main": "index.js",
  "scripts": {
    "build:local": "tsc -p tsconfig.node.local.json && vite build --config vite.local.config.ts && cp -R ./src/.well-known ./dist/.well-known && cp ./staticwebapp.config.json ./dist/staticwebapp.config.json",
    "build:dev": "tsc -p tsconfig.node.dev.json && VITE_ENVIRONMENT=dev vite build --config vite.dev.config.ts && cp -R ./src/.well-known ./dist/.well-known && cp ./staticwebapp.config.json ./dist/staticwebapp.config.json",
    "build:test": "tsc -p tsconfig.node.test.json && VITE_ENVIRONMENT=test vite build --config vite.test.config.ts && cp -R ./src/.well-known ./dist/.well-known && cp ./staticwebapp.config.json ./dist/staticwebapp.config.json",
    "build:prod": "tsc -p tsconfig.node.prod.json && VITE_ENVIRONMENT=prod vite build --config vite.prod.config.ts && cp -R ./src/.well-known ./dist/.well-known && cp ./staticwebapp.config.json ./dist/staticwebapp.config.json",
    "build:watch": "nodemon --watch src --ext ts,tsx,js,jsx --exec \"vite build\"",
    "commit": "cz",
    "local": "vite --config vite.local.config.ts",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "shell": "tsx ./bin/shell.mts",
    "test": "export TS_NODE_PROJECT='./tsconfig.test.json' && mocha -r tsx ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts",
    "test:coverage": "c8 --all --reporter cobertura --reporter text --reporter lcov --reporter html npm run test",
    "test:features": "./node_modules/.bin/cucumber-js -p default",
    "tsx": "tsx"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
{{{overridesJson}}}
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "{{cucumberCucumberVersion}}",
    "@eslint/compat": "{{eslintCompatVersion}}",
    "@eslint/eslintrc": "{{eslintEslintrcVersion}}",
    "@eslint/js": "{{eslintJsVersion}}",
