{
  "name": "@node-in-layers/toolkit",
  "type": "module",
  "version": "1.16.1",
  "description": "The official toolkit for creating/updating/maintaining Node In Layer based systems.",
  "main": "index.js",
  "bin": {
    "nil-toolkit": "bin/nil-toolkit.js"
  },
  "scripts": {
    "build": "./bin/build.sh",
    "build:watch": "nodemon -e '*' --watch ./src --exec \"npm run build || exit 1\"",
    "commit": "cz",
    "dist": "npm run build && cd dist && npm publish",
    "eslint": "eslint .",
    "feature-tests": "./node_modules/.bin/cucumber-js -p default",
    "prettier": "prettier --write .",
    "prettier:check": "prettier -c .",
    "test": "export TS_NODE_PROJECT='./tsconfig.test.json' && mocha -r tsx ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts",
    "test:coverage": "c8 --all --reporter cobertura --reporter text --reporter lcov --reporter html npm run test"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "external-editor": {
      "tmp": ">=0.2.6"
    },
    "commitizen": {
      "lodash": "4.18.1",
      "inquirer": {
        "external-editor": {
          "tmp": ">=0.2.6"
        }
      }
    },
    "mocha": {
      "diff": ">=8.0.3",
      "serialize-javascript": "$serialize-javascript"
    },
    "sinon": {
      "diff": ">=8.0.3"
    },
    "@cucumber/cucumber": {
      "tmp": ">=0.2.6"
    }
  },
  "author": "Node In Layers",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@types/chai-as-promised": "^8.0.1",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/lodash": "^4.17.13",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.19.20",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@typescript/native-preview": "^7.0.0-dev.20260604.1",
    "@vitejs/plugin-react": "^4.3.4",
    "argparse": "^2.0.1",
    "c8": "^11.0.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-functional": "~7.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "esprima": "^4.0.1",
    "fetch-blob": "^4.0.0",
    "globals": "^15.12.0",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "proxyquire": "^2.1.3",
    "serialize-javascript": "^7.0.5",
    "sinon": "^21.0.1",
    "sinon-chai": "^3.5.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@node-in-layers/auth": "^1.3.0",
    "@node-in-layers/core": "^1.17.1",
    "@node-in-layers/data": "^1.3.7",
    "@node-in-layers/mcp-client": "^1.8.1",
    "@node-in-layers/mcp-server": "^2.7.0",
    "@node-in-layers/rest-api": "^1.1.2",
    "@node-in-layers/rest-client": "^1.0.0",
    "@node-in-layers/secrets": "^1.0.1",
    "@node-in-layers/tasks": "^1.1.2",
    "argparse": "^2.0.1",
    "chalk": "^4.1.2",
    "es-main": "^1.3.0",
    "express": "^5.1.0",
    "functional-models": "^3.11.0",
    "functional-models-orm-mcp": "^3.7.1",
    "glob": "^11.0.0",
    "handlebars": "^4.7.8",
    "lodash": "^4.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.3.0",
    "zod": "^4.1.12"
  }
}
